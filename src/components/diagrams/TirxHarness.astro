---
import Figure from '../Figure.astro';
---

<Figure caption="TIRx Harness 分层：负载契约定义对错，Agent 在 skills 引导下工作，工具层负责写 kernel、检查与计时，kcoral 把 GPU 任务搬到远端。">
	<div class="ka-diagram ka-tirx">
		<svg
			viewBox="0 0 960 452"
			role="img"
			aria-labelledby="ka-tirx-title ka-tirx-desc"
			xmlns="http://www.w3.org/2000/svg"
		>
			<title id="ka-tirx-title">TIRx Harness 分层结构</title>
			<desc id="ka-tirx-desc">
				左侧是定义正确性与性能的工作负载契约，中间是受 skills 引导的 Agent 工作流，右侧是工具层：TIRx-lite 写 kernel、编译期分析检查同步与竞争与数值、知识库、基准服务；最右是 kcoral 远程执行，把 GPU 任务发到另一台机器。底部的反馈回路把优化后的 kernel 与演进记录写回知识库。
			</desc>

			<defs>
				<pattern id="ka-tirx-grid" width="28" height="28" patternUnits="userSpaceOnUse">
					<path d="M28 0H0V28" fill="none" stroke="var(--ka-dg-grid)" stroke-width="1"></path>
				</pattern>
				<marker
					id="ka-tirx-arrow"
					viewBox="0 0 8 8"
					refX="6.6"
					refY="4"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M0 0 8 4 0 8Z" fill="var(--ka-dg-line-strong)"></path>
				</marker>
				<marker
					id="ka-tirx-arrow-teal"
					viewBox="0 0 8 8"
					refX="6.6"
					refY="4"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M0 0 8 4 0 8Z" fill="var(--ka-dg-teal)"></path>
				</marker>
			</defs>

			<rect width="960" height="452" fill="url(#ka-tirx-grid)" opacity="0.6"></rect>

			<text x="28" y="34" class="dg-mono dg-muted" font-size="12.5">
				TIRX HARNESS · 编译器作为 Agent 的工具层
			</text>
			<text x="932" y="34" text-anchor="end" class="dg-mono dg-teal" font-size="12.5">
				OPEN SOURCE · 2026-09
			</text>

			<!-- 01 工作负载契约 -->
			<g>
				<rect x="28" y="112" width="156" height="140" rx="13" class="dg-surface dg-line"></rect>
				<text x="44" y="137" class="dg-mono dg-faint" fill="var(--ka-dg-muted)" font-size="12">01 / CONTRACT</text>
				<text x="44" y="170" class="dg-title dg-text" font-size="21">负载契约</text>
				<text x="44" y="197" class="dg-muted" font-size="15">正确性怎么算</text>
				<text x="44" y="219" class="dg-muted" font-size="15">性能怎么算</text>
				<text x="44" y="241" class="dg-muted" font-size="15">baseline 与阈值</text>
			</g>

			<!-- 02 Agent 工作流 -->
			<g>
				<rect x="204" y="112" width="180" height="140" rx="13" class="dg-surface dg-line"></rect>
				<text x="220" y="137" class="dg-mono dg-muted" font-size="12">02 / AGENT</text>
				<text x="220" y="170" class="dg-title dg-text" font-size="21">Agent 工作流</text>
				<text x="220" y="197" class="dg-muted" font-size="15">skills 引导用法</text>
				<text x="220" y="219" class="dg-muted" font-size="15">写代码 · 编译 · 迭代</text>
				<text x="220" y="241" class="dg-muted" font-size="15">直到满足契约</text>
			</g>

			<!-- 03 工具层 -->
			<g>
				<rect x="404" y="96" width="290" height="172" rx="14" class="dg-surface-2 dg-line-strong"></rect>
				<text x="418" y="122" class="dg-mono dg-teal" font-size="12">03 / TOOL LAYER</text>

				<g>
					<rect x="416" y="134" width="132" height="54" rx="9" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-teal)" stroke-width="1"></rect>
					<text x="482" y="156" text-anchor="middle" class="dg-text" font-size="14.5">TIRx-lite</text>
					<text x="482" y="176" text-anchor="middle" class="dg-muted" font-size="13">写 kernel</text>
				</g>
				<g>
					<rect x="556" y="134" width="130" height="54" rx="9" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-teal)" stroke-width="1"></rect>
					<text x="621" y="156" text-anchor="middle" class="dg-text" font-size="14.5">编译期分析</text>
					<text x="621" y="176" text-anchor="middle" class="dg-muted" font-size="13">同步 · 竞争 · 数值</text>
				</g>
				<g>
					<rect x="416" y="196" width="132" height="54" rx="9" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-teal)" stroke-width="1"></rect>
					<text x="482" y="218" text-anchor="middle" class="dg-text" font-size="14.5">知识库</text>
					<text x="482" y="238" text-anchor="middle" class="dg-muted" font-size="13">算子 · 经验 · trace</text>
				</g>
				<g>
					<rect x="556" y="196" width="130" height="54" rx="9" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-teal)" stroke-width="1"></rect>
					<text x="621" y="218" text-anchor="middle" class="dg-text" font-size="14.5">基准服务</text>
					<text x="621" y="238" text-anchor="middle" class="dg-muted" font-size="13">计时 · 打分</text>
				</g>
			</g>

			<!-- 04 kcoral 远程执行 -->
			<g>
				<rect x="714" y="112" width="218" height="140" rx="13" fill="var(--ka-dg-amber-soft)" stroke="var(--ka-dg-amber)" stroke-width="1.4"></rect>
				<text x="730" y="137" class="dg-mono dg-amber" font-size="12">04 / REMOTE</text>
				<text x="730" y="170" class="dg-title dg-amber" font-size="21">kcoral</text>
				<text x="730" y="197" class="dg-muted" font-size="15">Agent 留在本机</text>
				<text x="730" y="219" class="dg-muted" font-size="15">GPU 任务发到远端</text>
				<text x="730" y="241" class="dg-muted" font-size="15">契约与工具不变</text>
			</g>

			<!-- 主流程箭头 -->
			<g aria-hidden="true" fill="none" stroke="var(--ka-dg-line-strong)" stroke-width="1.4">
				<path d="M184 182H198" marker-end="url(#ka-tirx-arrow)"></path>
				<path d="M384 182H398" marker-end="url(#ka-tirx-arrow)"></path>
				<path d="M694 182H708" marker-end="url(#ka-tirx-arrow)"></path>
			</g>

			<!-- 反馈回路 -->
			<g aria-hidden="true">
				<path
					d="M482 250V312"
					fill="none"
					stroke="var(--ka-dg-teal)"
					stroke-width="1.3"
					stroke-dasharray="4 5"
					marker-end="url(#ka-tirx-arrow-teal)"
				></path>
				<path
					d="M404 372H300V258"
					fill="none"
					stroke="var(--ka-dg-teal)"
					stroke-width="1.3"
					stroke-dasharray="4 5"
					marker-end="url(#ka-tirx-arrow-teal)"
				></path>
			</g>

			<g>
				<rect x="28" y="316" width="904" height="94" rx="14" class="dg-surface dg-line"></rect>
				<text x="48" y="345" class="dg-mono dg-teal" font-size="12">FEEDBACK / 反馈回路</text>
				<text x="48" y="374" class="dg-muted" font-size="15.5">
					优化后的 kernel 与演进记录写回知识库，下一轮不必从零开始
				</text>
				<text x="48" y="396" class="dg-mono dg-faint" fill="var(--ka-dg-muted)" font-size="12">
					自改进的前提是每一轮的产物可复查，而不是只有最终答案
				</text>
			</g>
		</svg>
	</div>
</Figure>
