---
import Figure from '../Figure.astro';
---

<Figure caption="Agent harness 的基本闭环：工具循环产出证据，验证决定是否继续，预算贯穿全程。">
	<div class="ka-diagram ka-harness">
		<svg
			viewBox="0 0 960 420"
			role="img"
			aria-labelledby="ka-harness-title ka-harness-desc"
			xmlns="http://www.w3.org/2000/svg"
		>
			<title id="ka-harness-title">Agent harness 循环</title>
			<desc id="ka-harness-desc">
				任务规格进入计划，再进入由 read、edit、run、profile 组成的工具循环；验证通过后记录，不通过则带着证据回到工具循环。预算约束贯穿全程。
			</desc>

			<defs>
				<pattern id="ka-harness-grid" width="28" height="28" patternUnits="userSpaceOnUse">
					<path d="M28 0H0V28" fill="none" stroke="var(--ka-dg-grid)" stroke-width="1"></path>
				</pattern>
				<marker
					id="ka-harness-arrow"
					viewBox="0 0 8 8"
					refX="6.6"
					refY="4"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M0 0 8 4 0 8Z" fill="var(--ka-dg-line-strong)"></path>
				</marker>
				<marker
					id="ka-harness-arrow-amber"
					viewBox="0 0 8 8"
					refX="6.6"
					refY="4"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M0 0 8 4 0 8Z" fill="var(--ka-dg-amber)"></path>
				</marker>
			</defs>

			<rect width="960" height="420" fill="url(#ka-harness-grid)" opacity="0.6"></rect>

			<text x="28" y="34" class="dg-mono dg-muted" font-size="12.5">
				AGENT HARNESS · 一次任务的闭环
			</text>
			<text x="932" y="34" text-anchor="end" class="dg-mono dg-amber" font-size="12.5">
				BUDGET / 预算
			</text>

			<!-- 预算贯穿全程 -->
			<g aria-hidden="true">
				<path d="M28 54H398M622 54H932" fill="none" stroke="var(--ka-dg-amber)" stroke-width="1" stroke-dasharray="3 5" opacity="0.55"></path>
				<path d="M101 54V63M271 54V63M490 54V63M712 54V63M872 54V63" fill="none" stroke="var(--ka-dg-amber)" stroke-width="1" opacity="0.4"></path>
				<rect x="398" y="41" width="224" height="26" rx="13" fill="var(--ka-dg-bg)" stroke="var(--ka-dg-amber)" stroke-width="1" opacity="0.95"></rect>
				<text x="510" y="58.5" text-anchor="middle" class="dg-mono dg-amber" font-size="12">
					预算贯穿全程，不是建议
				</text>
			</g>

			<!-- 01 任务规格 -->
			<g>
				<rect x="28" y="112" width="146" height="120" rx="13" class="dg-surface dg-line"></rect>
				<text x="44" y="137" class="dg-mono dg-faint" fill="var(--ka-dg-muted)" font-size="12">01 / TASK</text>
				<text x="44" y="171" class="dg-title dg-text" font-size="22">任务规格</text>
				<text x="44" y="198" class="dg-muted" font-size="15.5">验收 · 预算</text>
				<text x="44" y="217" class="dg-muted" font-size="15.5">正确性 / 性能</text>
			</g>

			<!-- 02 计划 -->
			<g>
				<rect x="198" y="112" width="146" height="120" rx="13" class="dg-surface dg-line"></rect>
				<text x="214" y="137" class="dg-mono dg-muted" font-size="12">02 / PLAN</text>
				<text x="214" y="171" class="dg-title dg-text" font-size="22">计划</text>
				<text x="214" y="198" class="dg-muted" font-size="15.5">步骤 · 风险</text>
				<text x="214" y="217" class="dg-muted" font-size="15.5">先改哪里</text>
			</g>

			<!-- 03 工具循环 -->
			<g>
				<rect x="368" y="96" width="244" height="152" rx="14" class="dg-surface-2 dg-line-strong"></rect>
				<text x="380" y="122" class="dg-mono dg-teal" font-size="12">03 / TOOL LOOP</text>

				<g>
					<rect x="380" y="136" width="108" height="32" rx="7" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-line)" stroke-width="1"></rect>
					<text x="434" y="157" text-anchor="middle" class="dg-mono dg-text" font-size="14">read 读取</text>
				</g>
				<g>
					<rect x="494" y="136" width="108" height="32" rx="7" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-line)" stroke-width="1"></rect>
					<text x="548" y="157" text-anchor="middle" class="dg-mono dg-text" font-size="14">edit 编辑</text>
				</g>
				<g>
					<rect x="380" y="176" width="108" height="32" rx="7" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-line)" stroke-width="1"></rect>
					<text x="434" y="197" text-anchor="middle" class="dg-mono dg-text" font-size="14">run 运行</text>
				</g>
				<g>
					<rect x="494" y="176" width="108" height="32" rx="7" fill="var(--ka-dg-surface)" stroke="var(--ka-dg-line)" stroke-width="1"></rect>
					<text x="548" y="197" text-anchor="middle" class="dg-mono dg-text" font-size="14">profile 性能</text>
				</g>

				<text x="380" y="231" class="dg-muted" font-size="13.5">每一轮都留下可复核的证据</text>
			</g>

			<!-- 04 验证 -->
			<g>
				<rect x="636" y="104" width="152" height="136" rx="14" fill="var(--ka-dg-amber-soft)" stroke="var(--ka-dg-amber)" stroke-width="1.4"></rect>
				<text x="652" y="131" class="dg-mono dg-amber" font-size="12">04 / VERIFY</text>
				<g transform="translate(764 125)" aria-hidden="true">
					<circle cx="0" cy="0" r="9" fill="var(--ka-dg-amber-soft)" stroke="var(--ka-dg-amber)" stroke-width="1"></circle>
					<path d="M-4 0.5 -1 3.5 4.5 -2.5" fill="none" stroke="var(--ka-dg-amber)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</g>
				<text x="652" y="167" class="dg-title dg-amber" font-size="22">验证</text>
				<text x="652" y="194" class="dg-muted" font-size="15.5">测试 · baseline</text>
				<text x="652" y="213" class="dg-muted" font-size="15.5">证据是否完整</text>
				<text x="652" y="231" class="dg-mono dg-faint" fill="var(--ka-dg-muted)" font-size="12">唯一放行条件</text>
			</g>

			<!-- 05 记录 -->
			<g>
				<rect x="812" y="112" width="120" height="120" rx="13" class="dg-surface dg-line"></rect>
				<text x="828" y="137" class="dg-mono dg-muted" font-size="12">05 / RECORD</text>
				<text x="828" y="171" class="dg-title dg-text" font-size="22">记录</text>
				<text x="828" y="198" class="dg-muted" font-size="15.5">保留理由</text>
				<text x="828" y="217" class="dg-muted" font-size="15.5">放弃模式</text>
			</g>

			<!-- 主流程箭头 -->
			<g aria-hidden="true" fill="none" stroke="var(--ka-dg-line-strong)" stroke-width="1.4">
				<path d="M174 172H192" marker-end="url(#ka-harness-arrow)"></path>
				<path d="M344 172H362" marker-end="url(#ka-harness-arrow)"></path>
				<path d="M612 172H630" marker-end="url(#ka-harness-arrow)"></path>
				<path d="M788 172H806" marker-end="url(#ka-harness-arrow)"></path>
			</g>

			<!-- 验证失败回流 -->
			<g aria-hidden="true">
				<path
					d="M712 240V286H500V254"
					fill="none"
					stroke="var(--ka-dg-amber)"
					stroke-width="1.2"
					stroke-dasharray="4 5"
					marker-end="url(#ka-harness-arrow-amber)"
				></path>
				<text x="612" y="306" text-anchor="middle" class="dg-amber" font-size="14.5">
					不通过 · 带着失败证据回到工具循环
				</text>
			</g>

			<!-- 预算仪表 -->
			<g>
				<rect x="28" y="326" width="904" height="74" rx="14" class="dg-surface dg-line"></rect>
				<text x="48" y="357" class="dg-mono dg-amber" font-size="12">BUDGET / 预算</text>
				<text x="48" y="382" class="dg-muted" font-size="15.5">时间 · 调用次数 · 花费</text>

				<rect x="438" y="346" width="474" height="8" rx="4" fill="var(--ka-dg-surface-2)" stroke="var(--ka-dg-line)" stroke-width="1"></rect>
				<rect x="438" y="346" width="292" height="8" rx="4" fill="var(--ka-dg-teal)" opacity="0.7"></rect>
				<text x="912" y="340" text-anchor="end" class="dg-mono dg-muted" font-size="11.5">已用 62% · 示意</text>
				<text x="438" y="382" class="dg-muted" font-size="14">
					停止条件：预算耗尽 · 连续无改进 · 满足验收
				</text>
			</g>
		</svg>
	</div>
</Figure>
