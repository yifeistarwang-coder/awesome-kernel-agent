				<text x="490" y="679" class="dg-muted" font-size="11.5">唯一允许含示例代码</text>
			</g>
			<g>
				<rect x="700" y="616" width="232" height="76" rx="11" class="dg-surface dg-line"></rect>
				<text x="714" y="640" class="dg-text" font-size="14">tests/ · 1850 个</text>
				<text x="714" y="661" class="dg-muted" font-size="11.5">80 个文件，CPU 可跑</text>
				<text x="714" y="679" class="dg-muted" font-size="11.5">FakeBackend 验证控制流</text>
			</g>
		</svg>
	</div>
</Figure>
