			<g>
				<rect x="28" y="616" width="212" height="76" rx="11" class="dg-surface dg-line"></rect>
				<text x="42" y="640" class="dg-text" font-size="14">meta/ · 19 份</text>
				<text x="42" y="661" class="dg-muted" font-size="11.5">operator-agnostic 提示词</text>
				<text x="42" y="679" class="dg-muted" font-size="11.5">运行时绑定，不写算子名</text>
			</g>
			<g>
				<rect x="252" y="616" width="212" height="76" rx="11" class="dg-surface dg-line"></rect>
				<text x="266" y="640" class="dg-text" font-size="14">skills/ · 7 个</text>
				<text x="266" y="661" class="dg-muted" font-size="11.5">SKILL.md + 脚本</text>
				<text x="266" y="679" class="dg-muted" font-size="11.5">机器判词，harness 可导入</text>
			</g>
			<g>
				<rect x="476" y="616" width="212" height="76" rx="11" class="dg-surface dg-line"></rect>
				<text x="490" y="640" class="dg-text" font-size="14">hw_kb/ · 192 条</text>
