			</g>

			<!-- 数据流 -->
			<g aria-hidden="true" fill="none" stroke-width="1.3">
				<path d="M604 360H620" stroke="var(--ka-dg-line-strong)" marker-end="url(#ka-fkarch-arrow)"></path>
				<path d="M620 400H604" stroke="var(--ka-dg-teal)" stroke-dasharray="4 4" marker-end="url(#ka-fkarch-arrow-teal)"></path>
				<path d="M588 512H620" stroke="var(--ka-dg-line-strong)" marker-end="url(#ka-fkarch-arrow)"></path>
				<path d="M780 500V490" stroke="var(--ka-dg-teal)" stroke-dasharray="4 4" marker-end="url(#ka-fkarch-arrow-teal)"></path>
			</g>

