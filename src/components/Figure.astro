---
interface Props {
	caption: string;
}

const { caption } = Astro.props;
---

<figure class="ka-figure">
	<div class="ka-figure-scroll" tabindex="0" role="group" aria-label="图示，可横向滚动">
		<div class="ka-figure-canvas">
			<slot />
		</div>
	</div>
	<figcaption>
		<span class="ka-figure-mark" aria-hidden="true">图</span>
		<span class="ka-figure-caption">{caption}</span>
		<span class="ka-figure-hint" aria-hidden="true">横向滑动查看完整图 →</span>
	</figcaption>
</figure>

<style>
	.ka-figure {
		position: relative;
		margin-block: 2rem;
		overflow: hidden;
		border: 1px solid var(--ka-line);
		border-radius: var(--ka-radius-md);
		background:
			linear-gradient(180deg, var(--ka-teal-soft), transparent 38%),
			var(--ka-dg-bg);
		box-shadow: var(--ka-shadow-card);
		scroll-margin-top: calc(var(--sl-nav-height) + 1.25rem);
	}

	.ka-figure::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 1.2rem;
		width: 3.5rem;
		height: 1px;
		background: linear-gradient(90deg, var(--ka-teal), transparent);
		opacity: 0.8;
	}

	.ka-figure-scroll {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding: 0.9rem;
		scrollbar-width: thin;
		scrollbar-color: var(--ka-line-strong) transparent;
		/* Edge fades hint that the diagram continues past the viewport. */
		mask-image: linear-gradient(90deg, transparent 0, #000 1.25rem, #000 calc(100% - 1.25rem), transparent 100%);
		-webkit-mask-image: linear-gradient(90deg, transparent 0, #000 1.25rem, #000 calc(100% - 1.25rem), transparent 100%);
	}

	.ka-figure-scroll:focus-visible {
		outline: 2px solid var(--ka-focus);
		outline-offset: -3px;
	}

	/* The edge fade masks the focus ring, so the ring is also drawn on the
	   figure itself (outside the mask) whenever the scroll area is focused. */
	.ka-figure:has(.ka-figure-scroll:focus-visible) {
		outline: 2px solid var(--ka-focus);
		outline-offset: 2px;
	}

	.ka-figure-scroll::-webkit-scrollbar {
		height: 8px;
	}

	.ka-figure-scroll::-webkit-scrollbar-thumb {
		border: 2px solid transparent;
		border-radius: 8px;
		background-clip: content-box;
		background-color: var(--ka-line-strong);
	}

	.ka-figure-scroll::-webkit-scrollbar-thumb:hover {
		background-color: var(--ka-teal);
	}

	/* Diagrams are authored at 960 units wide. Keeping a minimum rendered
	   width stops the SVG from shrinking so far that its labels become
	   unreadable; the container scrolls instead of squeezing the artwork. */
	.ka-figure-canvas {
		min-width: 920px;
	}

	figcaption {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 0.8rem 1rem 0.85rem;
		border-top: 1px solid var(--ka-line);
		background: color-mix(in srgb, var(--ka-dg-surface) 72%, transparent);
		color: var(--ka-muted);
		font-size: 0.78rem;
		line-height: 1.65;
	}

	.ka-figure-mark {
		display: inline-grid;
		place-items: center;
		flex: 0 0 auto;
		min-width: 1.35rem;
		height: 1.35rem;
		margin-top: 0.05rem;
		border: 1px solid color-mix(in srgb, var(--ka-teal) 34%, var(--ka-line));
		border-radius: 4px;
		background: var(--ka-teal-soft);
		color: var(--ka-teal);
		font-family: var(--ka-font-mono);
		font-size: 0.58rem;
		line-height: 1;
	}

	.ka-figure-caption {
		min-width: 0;
	}

	.ka-figure-hint {
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		margin-inline-start: auto;
		color: var(--ka-faint);
		font-family: var(--ka-font-mono);
		font-size: 0.6rem;
		white-space: nowrap;
	}

	@media (max-width: 50rem) {
		.ka-figure-scroll {
			padding: 0.5rem;
		}

		figcaption {
			padding: 0.75rem 0.8rem;
		}
	}
</style>
