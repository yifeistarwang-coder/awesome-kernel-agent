---
interface Stat {
	value: string;
	suffix?: string;
	label: string;
	note: string;
	text?: boolean;
}

const stats: Stat[] = [
	{ value: '10', label: '篇系统内容', note: '导读 → 进阶' },
	{ value: '107', label: '条术语', note: '中英对照' },
	{ value: '13', label: '道动手练习', note: 'L1 – L4' },
	{ value: '持续更新', label: '上游仍在演进', note: '资料核对 2026.10', text: true },
];
---

<section class="ka-stats" aria-label="站点数据概览">
	<div class="ka-shell">
		<div class="ka-stats-grid" data-reveal>
			{
				stats.map((stat) => (
					<div class="ka-stat">
						<p class:list={['ka-stat-value', stat.text && 'ka-stat-value--text']}>
							{stat.value}
							{stat.suffix && <span class="plus">{stat.suffix}</span>}
						</p>
						<p class="ka-stat-label">{stat.label}</p>
						<p class="ka-stat-note">{stat.note}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
