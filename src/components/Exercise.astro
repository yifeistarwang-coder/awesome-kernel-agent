---
type Level = 'L1' | 'L2' | 'L3' | 'L4';

interface Props {
	level: Level;
	title: string;
	time?: string;
}

const { level, title, time } = Astro.props;

const levelNames: Record<Level, string> = {
	L1: '热身',
	L2: '基础',
	L3: '进阶',
	L4: '综合',
};
---

<section class="ka-exercise" data-level={level} aria-label={`${level} 动手练习：${title}`}>
	<header class="ka-exercise-head">
		<span class="ka-exercise-level">
			<span class="ka-exercise-code">{level}</span>
			<span class="ka-exercise-name">{levelNames[level]}</span>
		</span>
		{
			time && (
				<span class="ka-exercise-time">
					<svg
						viewBox="0 0 24 24"
						width="14"
						height="14"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="8.5" />
						<path d="M12 7.5V12l3 2" />
					</svg>
					<span>{time}</span>
				</span>
			)
		}
	</header>

	<h3 class="ka-exercise-title">{title}</h3>

	<div class="ka-exercise-body">
		<slot />
	</div>
</section>

<style>
	.ka-exercise {
		position: relative;
		margin-block: 2rem;
		padding: 1.3rem 1.35rem 1.25rem 1.4rem;
		overflow: hidden;
		border: 1px solid var(--ka-line);
		border-inline-start: 2px solid var(--ex);
		border-radius: var(--ka-radius-md);
		background:
			linear-gradient(135deg, var(--ex-bg), transparent 38%),
			var(--ka-surface);
		box-shadow: var(--ka-shadow-card);
	}

	.ka-exercise::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 1.25rem;
		width: 4rem;
		height: 1px;
		background: linear-gradient(90deg, var(--ex), transparent);
	}

	.ka-exercise[data-level='L1'] {
		--ex: var(--ka-teal);
		--ex-ink: var(--ka-teal);
		--ex-bg: rgba(94, 234, 212, 0.07);
		--ex-border: rgba(94, 234, 212, 0.28);
		--ex-solid-fg: #1b1304;
	}

	.ka-exercise[data-level='L2'] {
		--ex: var(--ka-cyan);
		--ex-ink: var(--ka-cyan);
		--ex-bg: rgba(34, 211, 238, 0.065);
		--ex-border: rgba(34, 211, 238, 0.26);
		--ex-solid-fg: #1b1304;
	}

	.ka-exercise[data-level='L3'] {
		--ex: var(--ka-amber);
		--ex-ink: var(--ka-amber);
		--ex-bg: rgba(251, 191, 36, 0.06);
		--ex-border: rgba(251, 191, 36, 0.24);
		--ex-solid-fg: #241a04;
	}

	.ka-exercise[data-level='L4'] {
		--ex: var(--ka-amber);
		--ex-ink: var(--ka-amber);
		--ex-bg: rgba(251, 191, 36, 0.09);
		--ex-border: rgba(251, 191, 36, 0.34);
		--ex-solid-fg: #241a04;
	}

	:global(:root[data-theme='light']) .ka-exercise[data-level='L1'] {
		--ex: #0f766e;
		--ex-ink: #0b6b62;
		--ex-bg: rgba(15, 118, 110, 0.055);
		--ex-border: rgba(15, 118, 110, 0.24);
	}

	:global(:root[data-theme='light']) .ka-exercise[data-level='L2'] {
		--ex: #0e7490;
		--ex-ink: #0b6577;
		--ex-bg: rgba(14, 116, 144, 0.05);
		--ex-border: rgba(14, 116, 144, 0.22);
	}

	:global(:root[data-theme='light']) .ka-exercise[data-level='L3'],
	:global(:root[data-theme='light']) .ka-exercise[data-level='L4'] {
		--ex: #9a5b06;
		--ex-ink: #7c4a03;
		--ex-bg: rgba(154, 91, 6, 0.055);
		--ex-border: rgba(154, 91, 6, 0.24);
		--ex-solid-fg: #ffffff;
	}

	.ka-exercise[data-level='L4'] {
		border-inline-start-width: 3px;
	}

	.ka-exercise-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.ka-exercise-level {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.22rem 0.55rem 0.22rem 0.26rem;
		border: 1px solid var(--ex-border);
		border-radius: var(--ka-radius-xs);
		background: var(--ex-bg);
		color: var(--ex-ink);
		font-family: var(--ka-font-mono);
		font-size: 0.63rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.4;
	}

	.ka-exercise-code {
		display: inline-grid;
		place-items: center;
		min-width: 1.5rem;
		padding: 0.1rem 0.24rem;
		border-radius: 3px;
		background: color-mix(in srgb, var(--ex) 16%, transparent);
		color: var(--ex-ink);
		font-weight: 600;
	}

	.ka-exercise[data-level='L4'] .ka-exercise-code {
		background: var(--ex);
		color: var(--ex-solid-fg);
	}

	.ka-exercise-name {
		padding-inline-end: 0.15rem;
	}

	.ka-exercise-time {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--ka-faint);
		font-family: var(--ka-font-mono);
		font-size: 0.64rem;
		line-height: 1.5;
		white-space: nowrap;
	}

	.ka-exercise-time svg {
		flex: 0 0 auto;
		opacity: 0.85;
	}

	.ka-exercise-title {
		margin: 0.8rem 0 0;
		color: var(--ka-text-strong);
		font-family: var(--ka-font-display);
		font-size: 1.24rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.35;
	}

	.ka-exercise-title::before {
		display: none;
	}

	.ka-exercise-body {
		margin-top: 0.85rem;
		color: var(--ka-text);
		font-size: 0.94rem;
	}

	.ka-exercise-body :global(p) {
		margin: 0.62rem 0 0;
		color: var(--ka-text);
		line-height: 1.85;
	}

	.ka-exercise-body :global(p:first-child) {
		margin-top: 0;
	}

	.ka-exercise-body :global(ul),
	.ka-exercise-body :global(ol) {
		margin: 0.55rem 0 0;
		padding-inline-start: 1.2rem;
	}

	.ka-exercise-body :global(li) {
		margin-top: 0.28rem;
		color: var(--ka-text);
		line-height: 1.8;
	}

	.ka-exercise-body :global(li::marker) {
		color: var(--ex);
	}

	.ka-exercise-body :global(strong) {
		color: var(--ka-text-strong);
		font-weight: 600;
	}

	.ka-exercise-body :global(a) {
		color: var(--ka-link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.ka-exercise-body :global(code) {
		padding: 0.08em 0.34em;
		border: 1px solid var(--ka-inline-border);
		border-radius: var(--ka-radius-xs);
		background: var(--ka-inline-bg);
		color: var(--ka-text-strong);
		font-family: var(--ka-font-mono);
		font-size: 0.85em;
	}

	.ka-exercise-body :global(details) {
		margin: 1rem 0 0.15rem;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--ka-line);
		border-inline-start: 2px solid var(--ex-border);
		border-radius: var(--ka-radius-sm);
		background: var(--ka-surface-2);
	}

	.ka-exercise-body :global(details[open]) {
		border-inline-start-color: var(--ex);
	}

	.ka-exercise-body :global(summary) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		width: fit-content;
		margin: 0;
		padding: 0;
		color: var(--ex-ink);
		font-family: var(--ka-font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		line-height: 1.6;
	}

	.ka-exercise-body :global(summary)::before {
		flex: 0 0 auto;
	}

	.ka-exercise-body :global(details[open] > summary) {
		margin-bottom: 0.55rem;
	}

	.ka-exercise-body :global(details p:first-child) {
		margin-top: 0;
	}

	@media (max-width: 42rem) {
		.ka-exercise {
			padding: 1.15rem 1.05rem 1.1rem;
		}

		.ka-exercise-head {
			align-items: flex-start;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.ka-exercise-title {
			font-size: 1.14rem;
		}
	}
</style>
