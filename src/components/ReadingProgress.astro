---
/**
 * 阅读进度条 + 返回顶部。
 * 通过 Starlight 的 Footer 覆盖注入到每个页面（含 splash 首页）。
 */
---

<div class="ka-reading-progress" aria-hidden="true">
	<div class="ka-reading-progress__bar"></div>
</div>

<button type="button" class="ka-to-top" aria-label="返回顶部" title="返回顶部">
	<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M10 15.5V4.5"></path>
		<path d="M5 9.5 10 4.5l5 5"></path>
	</svg>
</button>

<script>
	function initReadingProgress() {
		const bar = document.querySelector<HTMLElement>('.ka-reading-progress__bar');
		const toTop = document.querySelector<HTMLButtonElement>('.ka-to-top');
		if (!bar || !toTop) return;

		// 移到 body 末尾：脱离内容面板的层叠上下文，避免被右侧目录栏遮挡。
		const progress = bar.parentElement;
		if (progress && progress.parentElement !== document.body) document.body.appendChild(progress);
		if (toTop.parentElement !== document.body) document.body.appendChild(toTop);

		let ticking = false;

		const update = () => {
			ticking = false;
			const doc = document.documentElement;
			const max = doc.scrollHeight - doc.clientHeight;
			const pct = max > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / max) * 100)) : 0;
			bar.style.transform = `scaleX(${pct / 100})`;
			toTop.classList.toggle('is-visible', doc.scrollTop > 400);
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		document.removeEventListener('scroll', onScroll);
		document.addEventListener('scroll', onScroll, { passive: true });
		window.removeEventListener('resize', onScroll);
		window.addEventListener('resize', onScroll, { passive: true });

		toTop.removeEventListener('click', onClick);
		toTop.addEventListener('click', onClick);

		function onClick() {
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
		}

		update();
	}

	document.addEventListener('astro:page-load', initReadingProgress);
	document.addEventListener('astro:after-swap', initReadingProgress);
	initReadingProgress();
</script>

<style>
	.ka-reading-progress {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		height: 3px;
		z-index: 60;
		pointer-events: none;
		background: transparent;
	}

	.ka-reading-progress__bar {
		height: 100%;
		width: 100%;
		transform: scaleX(0);
		transform-origin: left center;
		background: linear-gradient(90deg, var(--ka-teal, #5eead4), var(--ka-cyan, #22d3ee));
		box-shadow: 0 0 12px -2px var(--ka-teal, #5eead4);
		will-change: transform;
	}

	.ka-to-top {
		position: fixed;
		inset-block-end: 1.75rem;
		inset-inline-end: 1.75rem;
		z-index: 60;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--ka-line-strong, rgba(255, 255, 255, 0.14));
		border-radius: 999px;
		background: var(--ka-surface, #0b1220);
		color: var(--ka-text-strong, #f1f6fb);
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.5rem);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0.2s ease,
			border-color 0.2s ease,
			background-color 0.2s ease;
		box-shadow: var(--ka-shadow-card, 0 10px 30px -18px rgba(0, 0, 0, 0.8));
	}

	.ka-to-top.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.ka-to-top:hover {
		border-color: var(--ka-teal, #5eead4);
		color: var(--ka-teal, #5eead4);
	}

	.ka-to-top:focus-visible {
		outline: 2px solid var(--ka-teal, #5eead4);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.ka-reading-progress__bar,
		.ka-to-top {
			transition: none;
		}
	}
</style>
